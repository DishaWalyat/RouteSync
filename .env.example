# LifeLog Academic Platform - Cloud Environment Configuration
# Add these environment variables in your Vercel Project Settings:
# Settings -> Environment Variables -> Add (Production, Preview, Development)

# Firebase Web App Configuration (from Firebase Console -> Project Settings -> General -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=AIzaSyExampleKey12345
VITE_FIREBASE_AUTH_DOMAIN=lifelog-ccsa.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=lifelog-ccsa
VITE_FIREBASE_STORAGE_BUCKET=lifelog-ccsa.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
