rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Role detection via custom claims or persistent Firestore profile
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'admin')
      );
    }

    function isManufacturer() {
      return isSignedIn() && (
        isAdmin() ||
        request.auth.token.role == 'manufacturer' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'manufacturer')
      );
    }

    // User Profile Documents
    match /users/{userId} {
      // Authenticated participants can view user directory
      allow read: if isSignedIn();

      // On registration, role must not be admin unless written by admin
      allow create: if isSignedIn() && (
        (isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role != 'admin')) ||
        isAdmin()
      );

      // On update, users cannot elevate their own role to admin
      allow update: if (
        isOwner(userId) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'email']))
      ) || isAdmin();

      allow delete: if isAdmin();
    }

    // Multi-tenant Supply Chain Shipments
    match /shipments/{shipmentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();

      // Append-Only Tracking Events subcollection (Chain of Custody)
      match /events/{eventId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        // Strict tamper-evident audit: historical events cannot be modified or deleted
        allow update, delete: if false;
      }
    }

    // Root shipmentEvents (for global chronological feeds)
    match /shipmentEvents/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Products Catalog
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin() || isManufacturer();
    }

    // Warehouse Inventory
    match /inventory/{inventoryId} {
      allow read: if isSignedIn();
      // Strict negative inventory prevention enforced at database layer!
      allow create, update: if isSignedIn() &&
        (!('availableQuantity' in request.resource.data) || request.resource.data.availableQuantity >= 0);
      allow delete: if isAdmin();
    }

    // Inventory Audit Logs (Append-Only)
    match /inventoryAuditLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Shipment Documents Metadata
    match /shipmentDocuments/{docId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uploadedByUid == request.auth.uid);
    }

    // Delivery Tasks & Checkpoints
    match /deliveryTasks/{taskId} {
      allow read, write: if isSignedIn();
    }

    // Notifications & Broadcast Alerts
    match /notifications/{notificationId} {
      allow read, write: if isSignedIn();
    }
  }
}
